#!/bin/bash
# mkinitcpio install hook for tokenvault. Must come after 'systemd' and
# 'sd-encrypt' (tokenvault install appends it via /etc/mkinitcpio.conf.d).
#
# Boot flow in the initramfs:
#   run-tokenvault-esp.mount   ESP mounted read-only at /run/tokenvault/esp
#   tokenvault-tpm2.service    outer layer of the vault: TPM2 + PIN
#   tokenvault-fido2.service   inner layer: FIDO2 client PIN + touch
#   systemd-cryptsetup@<target> keyfile = /dev/mapper/tokenvault-fido2;
#                              passphrase prompt after keyfile-timeout
#   tokenvault-close.service   closes both layers + unmounts the ESP once
#                              the target is open, before switch-root
# Only /etc/tokenvault/state (non-secret) is read here; the config with the
# PINs never enters the image.

build() {
    local state=/etc/tokenvault/state unit=/etc/systemd/system
    local TARGET_UUID TARGET_NAME TARGET_OPTIONS ESP_PARTUUID VAULT_FILE
    local SECRET_LENGTH TOKEN_TIMEOUT KEYFILE_TIMEOUT TARGET_KEYSLOT
    if [[ ! -r $state ]]; then
        error "tokenvault: $state missing, run 'tokenvault enroll' first"
        return 1
    fi
    # shellcheck source=/dev/null
    source "$state"

    local scd=/usr/bin/systemd-cryptsetup esp=/run/tokenvault/esp
    local vault="$esp/$VAULT_FILE" target_unit
    target_unit="systemd-cryptsetup@$(systemd-escape "$TARGET_NAME").service"

    map add_module vfat 'nls_cp437?' 'nls_ascii?' 'nls_iso8859-1?' 'nls_utf8?' 'loop?' \
        'serpent_generic?' 'serpent-avx2?' 'serpent-avx-x86_64?' 'serpent-sse2-x86_64?' 'xts?'
    map add_binary "$scd" umount

    add_file - "$unit/run-tokenvault-esp.mount" 644 <<EOF
[Unit]
Description=tokenvault: ESP (read-only)
DefaultDependencies=no
Before=umount.target
Conflicts=umount.target

[Mount]
What=/dev/disk/by-partuuid/$ESP_PARTUUID
Where=$esp
Type=vfat
Options=ro,nodev,nosuid,noexec,umask=0077
EOF

    add_file - "$unit/tokenvault-tpm2.service" 644 <<EOF
[Unit]
Description=tokenvault: unlock TPM2 layer
DefaultDependencies=no
IgnoreOnIsolate=true
Conflicts=umount.target
RequiresMountsFor=$vault
After=cryptsetup-pre.target systemd-udevd-kernel.socket systemd-udevd.service systemd-tpm2-setup-early.service
Before=cryptsetup.target umount.target $target_unit

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutSec=infinity
KeyringMode=shared
# built-in TPM2/FIDO2 paths: they prompt "TPM2 PIN" / "security token PIN"
# instead of the token module's anonymous "LUKS2 token PIN"
Environment=SYSTEMD_CRYPTSETUP_USE_TOKEN_MODULE=0
ExecStart=$scd attach tokenvault-tpm2 $vault none tpm2-device=auto,token-timeout=$TOKEN_TIMEOUT,readonly,password-cache=no
ExecStop=-$scd detach tokenvault-tpm2
EOF

    add_file - "$unit/tokenvault-fido2.service" 644 <<EOF
[Unit]
Description=tokenvault: unlock FIDO2 layer
DefaultDependencies=no
IgnoreOnIsolate=true
Conflicts=umount.target
Requires=tokenvault-tpm2.service
After=tokenvault-tpm2.service dev-mapper-tokenvault\\x2dtpm2.device
Before=cryptsetup.target umount.target $target_unit

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutSec=infinity
KeyringMode=shared
Environment=SYSTEMD_CRYPTSETUP_USE_TOKEN_MODULE=0
ExecStart=$scd attach tokenvault-fido2 /dev/mapper/tokenvault-tpm2 none fido2-device=auto,token-timeout=$TOKEN_TIMEOUT,readonly,password-cache=no
ExecStop=-$scd detach tokenvault-fido2
EOF

    # Runs whether the vault worked or the passphrase fallback was used.
    add_file - "$unit/tokenvault-close.service" 644 <<EOF
[Unit]
Description=tokenvault: close vault and unmount ESP
DefaultDependencies=no
After=$target_unit tokenvault-fido2.service tokenvault-tpm2.service
Before=cryptsetup.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-$scd detach tokenvault-fido2
ExecStart=-$scd detach tokenvault-tpm2
ExecStart=-/usr/bin/umount $esp
EOF

    local u
    for u in tokenvault-tpm2.service tokenvault-fido2.service tokenvault-close.service; do
        add_symlink "$unit/cryptsetup.target.wants/$u" "$unit/$u"
    done

    # Replaces the crypttab sd-encrypt put in: other x-initrd.attach entries
    # are kept, the target is routed through the vault.
    local opts="keyfile-size=$SECRET_LENGTH,keyfile-timeout=$KEYFILE_TIMEOUT,x-initrd.attach"
    [[ -n $TARGET_OPTIONS ]] && opts+=",$TARGET_OPTIONS"
    {
        awk -v n="$TARGET_NAME" -v u="UUID=$TARGET_UUID" \
            '!/^\s*($|#)/ && $4 ~ /x-initrd\.attach/ && $1 != n && $2 != u' /etc/crypttab 2>/dev/null
        printf '%s UUID=%s /dev/mapper/tokenvault-fido2 %s\n' "$TARGET_NAME" "$TARGET_UUID" "$opts"
    } | add_file - /etc/crypttab 600
}

help() {
    cat <<HELPEOF
Unlocks the configured LUKS2 volume from a nested vault on the ESP that
opens only with TPM2 + PIN and FIDO2 + PIN + touch. Managed by 'tokenvault'.
HELPEOF
}

