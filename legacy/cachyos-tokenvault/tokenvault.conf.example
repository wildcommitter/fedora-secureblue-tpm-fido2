# tokenvault configuration -> /etc/tokenvault/tokenvault.conf (root:root 0600)
#
# Read by `tokenvault enroll|verify|install` and by the mkinitcpio hook at
# build time. It is NEVER copied into the initramfs: only non-secret unit
# files and paths derived from it are. Shell syntax; quote values.

# ---- target: the LUKS2 volume the vault unlocks ---------------------------
# Device (path, UUID=..., or PARTUUID=...). Mapper name must match root=.
TARGET_DEVICE="UUID=c077878a-836c-4414-8a17-55ad9ab1d401"
TARGET_NAME="luks-c077878a-836c-4414-8a17-55ad9ab1d401"
# An existing passphrase of the target, used once to add the vault keyslot.
# Leave empty to be prompted. This keyslot stays as your recovery path.
TARGET_PASSPHRASE=""
# Extra crypttab options for the target (e.g. "discard").
TARGET_OPTIONS=""

# ---- token passwords (plaintext, baked into the tokens) -------------------
# TPM2: the PIN becomes part of the TPM2 policy of the outer vault layer
# (systemd-cryptenroll --tpm2-with-pin). Any characters are allowed.
TPM2_PIN="change-me-tpm2"
# FIDO2: the key's own client PIN. If the key has no PIN it is set to this;
# if it has a different PIN, put the current one in FIDO2_CURRENT_PIN and it
# is changed. Min 4 chars. A touch is always required as well.
FIDO2_PIN="change-me-fido2"
FIDO2_CURRENT_PIN=""

# ---- tokens ---------------------------------------------------------------
TPM2_DEVICE="auto"            # auto | /dev/tpmrm0 | TCTI string (swtpm:...)
TPM2_PCRS="7"                 # PCR policy of the outer layer ("" = none)
TPM2_ARGON2ID_MEMORY="256M"   # PIN hardening cost; fixed so the initramfs
                              # never needs more RAM than at enrollment
TPM2_ARGON2ID_PARALLELISM="4" # lanes; fixed so cost doesn't depend on CPU count
FIDO2_DEVICE="auto"           # auto (exactly one key plugged) | /dev/hidrawN

# ---- vault (post-quantum symmetric cascade) -------------------------------
ESP="/boot"                          # mountpoint of the FAT boot partition
VAULT_FILE="tokenvault/vault.img"    # path relative to ESP
OUTER_CIPHER="aes-xts-plain64"       # TPM2 layer; 512-bit XTS key = AES-256
INNER_CIPHER="serpent-xts-plain64"   # FIDO2 layer; 512-bit XTS key = Serpent-256
VAULT_KEY_SIZE="512"
VAULT_HASH="sha512"
SECRET_LENGTH="64"                   # chars of the target passphrase (~420 bits)

# ---- boot behaviour -------------------------------------------------------
TOKEN_TIMEOUT="60s"     # wait this long for the TPM2/FIDO2 device to appear
KEYFILE_TIMEOUT="300s"  # after this, fall back to the target passphrase prompt
