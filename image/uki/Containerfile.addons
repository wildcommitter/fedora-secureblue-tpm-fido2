ARG RELEASE=overridden
# scroll-secure: pinned builder image, SOURCE_DATE_EPOCH (reproducible builds)
ARG MINIMAL_DIGEST=overridden
ARG SOURCE_DATE_EPOCH

# Capture scripts from the git repo
FROM scratch as scripts
COPY uki/scripts /

FROM quay.io/fedora/fedora-minimal:${RELEASE}@${MINIMAL_DIGEST} as builder
ARG SOURCE_DATE_EPOCH
# scroll-secure: dnf sees only this stage's lines of rpms.lock
ARG DNF_VAR_rpmlock=addons

RUN --mount=type=tmpfs,target=/run \
    --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/var \
    dnf install -y systemd-ukify sbsigntools

RUN --mount=type=tmpfs,target=/run \
    --mount=type=bind,from=scripts,src=/,target=/run/scripts \
    --mount=type=secret,id=secureboot_key \
    --mount=type=secret,id=secureboot_crt \
    /run/scripts/sign-uki-addons.sh

FROM scratch
COPY --from=builder /addons/ /
