ARG BASE=overridden
FROM $BASE as rootfs
# scroll-secure: SOURCE_DATE_EPOCH in every stage with a RUN (repro-lint P3)
ARG SOURCE_DATE_EPOCH

RUN <<EORUN
set -euxo pipefail
kver=$(cd "/usr/lib/modules" && echo *) && \
mv "/usr/lib/modules/$kver/vmlinuz" "/vmlinuz"
EORUN

FROM scratch
COPY --from=rootfs /vmlinuz /vmlinuz
