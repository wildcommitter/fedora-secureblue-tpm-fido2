#!/usr/bin/python3 -I
"""Enroll this image's own Secure Boot keys, keeping option ROMs loadable.

Use this instead of `ujust enroll-secure-boot-keys`. With only our db cert
enrolled, the firmware refuses every option ROM it cannot verify, and the
discrete GPU's GOP driver is one of them: no display in firmware or at boot.
This script adds the Authenticode SHA-256 of each option ROM the firmware
measured into PCR 2 (TPM event log) to db as EFI_CERT_SHA256 entries, the same
approach as `sbctl enroll-keys --tpm-eventlog`.

Run as root with the firmware in Setup Mode. Order: db, KEK, then PK, which
leaves Setup Mode. Re-run after a GPU/VBIOS change (Setup Mode again).

  enroll-secure-boot-keys [--dry-run]
"""
import re
import struct
import subprocess
import sys
import uuid
from pathlib import Path

KEYS = Path("/usr/share/secureblue/uki/keys")
EVENTLOG = Path("/sys/kernel/security/tpm0/binary_bios_measurements")
EFIVARS = Path("/sys/firmware/efi/efivars")
GLOBAL_GUID = "8be4df61-93ca-11d2-aa0d-00e098032b8c"
EFI_CERT_SHA256 = uuid.UUID("c1c41626-504c-4092-aca9-41f936934328")


def die(msg):
    print(f"enroll-secure-boot-keys: {msg}", file=sys.stderr)
    sys.exit(1)


def efivar(name, guid=GLOBAL_GUID):
    p = EFIVARS / f"{name}-{guid}"
    return p.read_bytes()[4:] if p.exists() else None  # strip attributes


def option_rom_hashes():
    out = subprocess.run(["tpm2_eventlog", str(EVENTLOG)], check=True,
                         capture_output=True, text=True).stdout
    hashes = []
    for ev in out.split("- EventNum:"):
        if not re.search(r"PCRIndex: 2\b", ev) or "EV_EFI_BOOT_SERVICES_DRIVER" not in ev:
            continue
        m = re.search(r"AlgorithmId: sha256\s+Digest: \"?([0-9a-f]{64})", ev)
        if not m:
            die("PCR 2 driver event without a sha256 digest; is the sha256 bank enabled?")
        if m.group(1) not in hashes:
            hashes.append(m.group(1))
    return hashes


def sha256_esl(hashes, owner):
    entry_size = 16 + 32
    body = b"".join(owner.bytes_le + bytes.fromhex(h) for h in hashes)
    return (EFI_CERT_SHA256.bytes_le
            + struct.pack("<III", 28 + len(body), 0, entry_size) + body)


def write_var(name, path, esl):
    var = EFIVARS / f"{name}-{GLOBAL_GUID}"
    if var.exists():
        subprocess.run(["chattr", "-i", str(var)], check=True)
    args = ["efi-updatevar", "-e", "-f", str(path), name] if esl else \
           ["efi-updatevar", "-f", str(path), name]
    subprocess.run(args, check=True)


def main():
    dry = "--dry-run" in sys.argv[1:]
    if efivar("SetupMode") != b"\x01":
        die("firmware is not in Setup Mode (clear the Platform Key in firmware setup first)")
    for f in ("PK/PK.auth", "KEK/KEK.esl", "db/db.esl", "GUID"):
        if not (KEYS / Path(f).name).exists():
            die(f"missing {KEYS / Path(f).name}")

    hashes = option_rom_hashes()
    print(f"option ROMs measured by firmware: {len(hashes)}")
    for h in hashes:
        print(f"  sha256 {h}")
    if not hashes:
        print("warning: no option ROMs in the event log; a GPU GOP would be blocked if one exists")

    owner = uuid.UUID((KEYS / "GUID").read_text().strip())
    db = Path("/run/scroll-secure-db.esl")
    db.write_bytes((KEYS / "db.esl").read_bytes() + (sha256_esl(hashes, owner) if hashes else b""))

    if dry:
        print(f"dry run: would write db ({db}), KEK, then PK")
        return
    write_var("db", db, esl=True)
    write_var("KEK", KEYS / "KEK.esl", esl=True)
    write_var("PK", KEYS / "PK.auth", esl=False)
    db.unlink()
    print("Enrolled. Turn Secure Boot on in firmware setup if it is not already, then reboot.")


if __name__ == "__main__":
    main()
