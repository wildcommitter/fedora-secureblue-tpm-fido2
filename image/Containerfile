# Root filesystem of the workstation image: secureblue Sericea (hardened Fedora
# Atomic Sway) + scroll (our hardened fork), KVM/libvirt, FIDO2 lock screen, software-rendered
# headless session over VNC.
#
# This is only the first stage. ./build.sh feeds it through uki/ to produce the
# sealed image: composefs backend, systemd-boot + UKI signed with our own db key,
# signed PCR 11 policy. The kernel and initramfs here are replaced there.
#
# Base and scroll are pinned; bump both deliberately (see README.md).

ARG FEDORA_VERSION=44
ARG BASE_IMAGE=ghcr.io/secureblue/sericea-main-hardened
# 44.20261016.0, kernel 7.2.10-200.fc44 (multi-arch index digest)
ARG BASE_DIGEST=sha256:f0c0433ddee9c8b85d8dd3648b0bd586d272c5312641943609a0022a32c48ebf

# ---------------------------------------------------------------------------
# Stage 1: build scroll from our fork (wildcommitter/scroll, see its FORK.md) as a
# local RPM, `--with hardened`, from a pinned, annotated tag. Never from CI
# artifacts or releases: the source is the pinned checkout, built here.
#
# The hardened profile has no Lua, IPC socket, scrollbar, Xwayland, Vulkan or X11
# backend, and has the sandbox (exec broker, seccomp, Landlock). %meson brings
# Fedora's hardening flags, and the spec's %check fails the build without them
# (check-hardening runs again in stage 3). Its wlroots is linked statically.
# ---------------------------------------------------------------------------
FROM quay.io/fedora/fedora:${FEDORA_VERSION} AS scroll-build

ARG SCROLL_REPO=https://github.com/wildcommitter/scroll
ARG SCROLL_REF=scroll-secure-20261019
ARG SCROLL_COMMIT=7c81a4373246ac89e92d5c62a9171581b5e8e3f4

RUN dnf -y install git rpm-build 'dnf5-command(builddep)' && dnf clean all

# Full history: make-srpm.sh takes version and snapshot date from git.
RUN git clone --branch "${SCROLL_REF}" "${SCROLL_REPO}" /src \
 && test "$(git -C /src rev-parse "refs/tags/${SCROLL_REF}^{commit}")" = "${SCROLL_COMMIT}" \
 && test "$(git -C /src rev-parse HEAD)" = "${SCROLL_COMMIT}"

RUN srpm=$(cd /src && packaging/make-srpm.sh -o /tmp/srpm) \
 && dnf -y builddep --define 'with_hardened 1' "$srpm" \
 && rpmbuild --rebuild --with hardened "$srpm" \
 && mkdir -p /out \
 && cp ~/rpmbuild/RPMS/x86_64/scroll-[0-9]*.hardened.fc*.x86_64.rpm /out/ \
 && test "$(ls /out | wc -l)" = 1 \
 && ls /out/scroll-[0-9]*.hardened.fc*.x86_64.rpm

# ---------------------------------------------------------------------------
# Stage 2: build hardened-unlock (../lockscreen, passed by build.sh as the
# `lockscreen` build context). Go modules are fetched against the pinned go.sum.
# ---------------------------------------------------------------------------
FROM quay.io/fedora/fedora:${FEDORA_VERSION} AS lockscreen-build

RUN dnf -y install golang gcc pkgconf-pkg-config gtk4-devel gtk4-layer-shell-devel \
      gobject-introspection-devel pam-devel libxcrypt-devel \
 && dnf clean all

COPY --from=lockscreen go.mod go.sum /src/
COPY --from=lockscreen cmd/ /src/cmd/
COPY --from=lockscreen internal/ /src/internal/
# duress-reset is the root-side helper of the duress canary: static, no cgo.
# The production locker must not contain the duresstest hook.
RUN --mount=type=cache,target=/root/go --mount=type=cache,target=/root/.cache/go-build \
    cd /src \
 && GOTOOLCHAIN=local GOFLAGS=-mod=readonly go build -trimpath -o /out/usr/bin/ ./cmd/hardened-unlock \
 && GOTOOLCHAIN=local GOFLAGS=-mod=readonly CGO_ENABLED=0 \
      go build -trimpath -o /out/usr/libexec/hardened-unlock/ ./cmd/duress-reset \
 && ! grep -q HARDENED_UNLOCK_DURESS_MARKER /out/usr/bin/hardened-unlock

# ---------------------------------------------------------------------------
# Stage 3: the bootable image.
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE}@${BASE_DIGEST}

COPY --from=lockscreen-build /out/ /

# scroll: the local RPM from stage 1 (bind-mounted, so the file doesn't stay in the
# image), no weak deps. /var is a tmpfs for the same reason as below.
RUN --mount=type=bind,from=scroll-build,source=/out,target=/tmp/scroll-rpm \
    --mount=type=tmpfs,target=/var \
    dnf -y install --setopt=install_weak_deps=False /tmp/scroll-rpm/scroll-[0-9]*.rpm \
 && dnf clean all \
 && rpm -q scroll | grep -q '\.hardened\.' \
 && scroll -v | grep -q packaged

# - libvirt modular daemons + swtpm/OVMF: VMs with vTPM and Secure Boot (also the
#   tokenvault e2e lab).
# - pam-u2f/pamu2fcfg/fido2-tools/tpm2-tools: lock screen + LUKS token enrollment.
# /var is a tmpfs here so nothing lands in the image's /var (bootc lint);
# the libvirt state dirs come back via files/usr/lib/tmpfiles.d/.
RUN --mount=type=tmpfs,target=/var \
    dnf -y install \
      libvirt-daemon-kvm libvirt-daemon-config-network qemu-kvm \
      virt-manager virt-install swtpm swtpm-tools edk2-ovmf \
      pam-u2f pamu2fcfg fido2-tools tpm2-tools \
      wayvnc swaylock swayidle gtk4-layer-shell \
 && dnf clean all

# Fail the build if the static-wlroots assumption broke and scroll needs a lib we lack,
# or hardened-unlock's GTK4 / layer-shell libs are missing.
RUN for b in /usr/bin/scroll /usr/bin/hardened-unlock; do \
        if ldd "$b" | grep -q 'not found'; then ldd "$b"; exit 1; fi; \
    done
# ... or scroll lost a hardening property of the Fedora flags.
COPY files/usr/libexec/scroll-secure/check-hardening /usr/libexec/scroll-secure/check-hardening
RUN /usr/libexec/scroll-secure/check-hardening /usr/bin/scroll

# scroll is built without IPC, so the stock config's `bar {}` (scrollbar needs IPC)
# can't work: delete the block. The sessions read only /etc/scroll/config, so a
# process running as the user can't plant `exec` lines in ~/.config/scroll/config.
# The stock $term (kitty) and $menu (wmenu-run) aren't in the image: use foot and
# rofi. rofi is a layer-shell client, which our scroll gives only to clients it
# starts itself, so the launcher binding uses exec_privileged.
RUN sed -i '/^bar {$/,/^}$/d' /etc/scroll/config \
 && ! grep -q '^bar {' /etc/scroll/config \
 && sed -i -e 's|^set \$term kitty$|set $term foot|' \
      -e 's|^set \$menu wmenu-run$|set $menu rofi -show drun|' \
      -e 's|^\([[:space:]]*bindsym \$mod+r\) exec \$menu$|\1 exec_privileged $menu|' \
      /etc/scroll/config \
 && grep -qx 'set $term foot' /etc/scroll/config \
 && grep -qx 'set $menu rofi -show drun' /etc/scroll/config \
 && grep -qE '^[[:space:]]*bindsym \$mod\+r exec_privileged \$menu$' /etc/scroll/config \
 && sed -i 's|^Exec=scroll$|Exec=scroll -c /etc/scroll/config|' \
      /usr/share/wayland-sessions/scroll.desktop \
 && grep -qx 'Exec=scroll -c /etc/scroll/config' /usr/share/wayland-sessions/scroll.desktop

# hardened-unlock: PAM stack (FIDO2 key, then password) and the scroll snippet that
# binds it to Mod+Alt+L, idle and suspend. The snippet only loads through the
# config.d include, which scroll's stock config ships commented out.
COPY --from=lockscreen etc/pam.d/hardened-unlock /etc/pam.d/hardened-unlock
COPY --from=lockscreen etc/scroll/config.d/ /etc/scroll/config.d/
RUN sed -i 's|^# include /etc/scroll/config\.d/\*$|include /etc/scroll/config.d/*|' /etc/scroll/config \
 && grep -qx 'include /etc/scroll/config.d/\*' /etc/scroll/config

# Duress canary: the socket-activated reset helper and its group. The canary
# itself (/etc/hardened-unlock/duress) is set on the machine, never shipped.
COPY --from=lockscreen usr/ /usr/
RUN systemctl enable hardened-unlock-duress.socket \
 && test -x /usr/libexec/hardened-unlock/duress-reset \
 && ! test -e /etc/hardened-unlock/duress

RUN systemctl enable \
      virtqemud.socket virtnetworkd.socket virtstoraged.socket \
      virtnodedevd.socket virtsecretd.socket virtlogd.socket

COPY files/ /
# Secure Boot key creation/enrollment (option ROM hashes into db); see README.md.
COPY uki/secure-boot-keys.sh /usr/libexec/scroll-secure/secure-boot-keys

# tokenvault: TPM2+FIDO2 LUKS unlock (see LUKS.md)
# The initramfs is rebuilt from the dracut config in uki/Containerfile.uki;
# build.sh checks the result with check-uki.
COPY files-luks/ /

# Fail the build if a tool the tokenvault CLI needs on the booted system is gone.
RUN for b in bash cryptsetup systemd-cryptenroll /usr/lib/systemd/systemd-cryptsetup \
             /usr/lib/systemd/systemd-pcrextend udevadm python3 findfs blkid findmnt \
             mountpoint shred awk openssl objdump objcopy lsinitrd keyctl; do \
        command -v "$b" > /dev/null || { echo "tokenvault dep missing: $b"; exit 1; }; \
    done \
 && python3 -c 'import fido2'

# tokenvault_conf_t: /etc/tokenvault (plaintext token PINs) as a security file
# type like shadow_t, out of reach of confined domains' etc_t read rules.
RUN semodule -i /usr/share/selinux/packages/tokenvault/tokenvault.cil \
 && semodule -l | grep -qx tokenvault

RUN chmod 0755 /usr/libexec/scroll-headless /usr/libexec/scroll-secure/secure-boot-keys \
      /usr/libexec/scroll-secure/wayland-session /usr/libexec/scroll-secure/check-hardening \
 && bootc container lint

LABEL org.opencontainers.image.title="scroll-secure" \
      org.opencontainers.image.description="secureblue Sericea + scroll, KVM, FIDO2 lock screen" \
      containers.bootc="1"
