#!/usr/bin/python3 -I
"""vmswitch: the guests' network switch, made of TAP devices and one nftables table.

Every guest NIC is a persistent TAP (vsXXXXXXXXXX). Networks are named groups of NICs.
The `netdev vmswitch` table hooks each TAP: at ingress, a frame from the NIC's own MAC
is duplicated to the other TAPs of its network, then dropped; at egress, only frames
from a peer on the same network pass, so the host's own frames are dropped. So guests on one network share an Ethernet segment (a hub, no MAC
learning), guests on different networks or on none see nothing, and the host stack
never takes part. No bridge, no daemon: the kernel and nft do the switching.

The network `uplink` is built in and routed instead: each NIC on it gets its own /30
(host 10.88.N.1, guest 10.88.N.2) and nftables masquerades it out of the host's
default route. Uplink guests reach the internet only: not the host's services, not
private or link-local ranges (the LAN), not each other. While any NIC is on uplink the
host forwards IPv4, and only these flows (the forward chain's policy is drop).

The network `llm` is built in and routed too, but to one place: the host's model server
(llm/README.md) at 10.89.255.1:8080, on the dummy interface llm0. Each NIC gets its own
/30 (host 10.89.N.1, guest 10.89.N.2, route 10.89.255.1 via 10.89.N.1). The NIC's
hooks and the input chain pass TCP to that address and port and nothing else; nothing
from an llm NIC is forwarded, so llm guests reach neither each other nor anything beyond.

  vmswitch show                         the switching table (JSON)
  vmswitch net add|del <net>
  vmswitch nic add <guest> <nic>        create the NIC's TAP (not on any network)
  vmswitch nic del <guest> <nic>
  vmswitch plug <guest> <nic> <net>|-   move the NIC to a network (or uplink), or off all
  vmswitch apply                        recreate TAPs and the table from the state
  vmswitch xml <guest> <nic>            libvirt <interface> for the guest's domain XML
  vmswitch usb list                     USB devices: usbguard state and the guest each is on
  vmswitch usb attach <guest> <id>      allow device <id> (usbguard) and hot-plug it into
                                        the running guest
  vmswitch usb detach <guest> <id>      unplug it from the guest and block it again

USB: usbguard blocks devices the policy doesn't allow. attach allows one for this
plug-in only (not in the policy) and hands it to the guest as a libvirt hostdev; QEMU
detaches any host driver when it claims the device. Hubs can't be attached.

Root only. State: $VMSWITCH_STATE (default /var/lib/vmswitch/table.json). TAPs belong
to $VMSWITCH_TAP_USER (default qemu), which libvirt's QEMU runs as.
"""
import fcntl
import hashlib
import json
import os
import re
import subprocess
import sys

STATE = os.environ.get("VMSWITCH_STATE", "/var/lib/vmswitch/table.json")
TAP_USER = os.environ.get("VMSWITCH_TAP_USER", "qemu")
SYSFS = os.environ.get("VMSWITCH_SYSFS", "/sys")
VIRSH = ("virsh", "-q", "-c", "qemu:///system")
USBDEV = re.compile(r'^(\d+): (allow|block|reject) id ([0-9a-f]{4}):([0-9a-f]{4}) '
                    r'.*?name "((?:[^"\\]|\\.)*)" .*?via-port "([^"]*)" with-interface (\S+|\{[^}]*\})')
TABLE = "vmswitch"
UPLINK = "uplink"
LLM = "llm"
# Routed networks: a /30 per NIC, 10.<prefix>.N.0/30; N=255 of llm is the service's.
ROUTED = {UPLINK: (88, 256), LLM: (89, 255)}
LLM_DEV, LLM_ADDR, LLM_PORT = "llm0", "10.89.255.1", 8080
# Never routed to from an uplink guest: this host's nets, the LAN, link-local, CGNAT,
# multicast and the rest of the reserved space.
NO_ROUTE = ("0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, "
            "172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/3")
NAME = re.compile(r"^[a-z0-9][a-z0-9_-]{0,31}$")


def die(msg):
    sys.exit(f"vmswitch: {msg}")


def check_name(kind, name):
    if not NAME.match(name):
        die(f"bad {kind} name {name!r} (a-z 0-9 _ -, up to 32, starts alnum)")
    return name


def load():
    try:
        with open(STATE) as f:
            st = json.load(f)
    except FileNotFoundError:
        st = {}
    st.setdefault("nets", [])
    st.setdefault("nics", {})
    for n in st["nics"].values():   # tables from before llm: "uplink" held the slot
        if "uplink" in n:
            n["slot"] = n.pop("uplink")
    return st


def save(st):
    tmp = STATE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(st, f, indent=1, sort_keys=True)
        f.write("\n")
    os.replace(tmp, STATE)


def key(guest, nic):
    return f"{check_name('guest', guest)}/{check_name('nic', nic)}"


def derive(k):
    """TAP name (15 chars max) and a locally administered MAC from guest/nic."""
    h = hashlib.sha256(k.encode()).hexdigest()
    return "vs" + h[:10], "52:54:00:" + ":".join(h[10 + 2 * i:12 + 2 * i] for i in range(3))


def run(*cmd, **kw):
    r = subprocess.run(cmd, capture_output=True, text=True, **kw)
    if r.returncode:
        die(f"{' '.join(cmd)}: {r.stderr.strip() or r.returncode}")
    return r.stdout


def tap_exists(tap):
    return os.path.exists(f"/sys/class/net/{tap}")


def routed_ips(n):
    """Host and guest ends of a routed NIC's /30 (uplink or llm)."""
    i = n["slot"]
    return f"10.{ROUTED[n['net']][0]}.{i}.1", f"10.{ROUTED[n['net']][0]}.{i}.2"


def tap_create(n):
    tap = n["tap"]
    if not tap_exists(tap):
        run("ip", "tuntap", "add", "dev", tap, "mode", "tap", "user", TAP_USER, "group", TAP_USER)
    # No IPv6 link-local address on a guest's wire. Switched NICs: no host address and
    # no ARP either (the egress hook drops the rest). Uplink NICs: the host's /30 end.
    run("ip", "addr", "flush", "dev", tap)
    if n["net"] in ROUTED:
        run("ip", "link", "set", "dev", tap, "addrgenmode", "none", "arp", "on", "up")
        run("ip", "addr", "add", routed_ips(n)[0] + "/30", "dev", tap)
    else:
        run("ip", "link", "set", "dev", tap, "addrgenmode", "none", "arp", "off", "up")


def tap_delete(tap):
    if tap_exists(tap):
        run("ip", "tuntap", "del", "dev", tap, "mode", "tap")


def ruleset(st):
    """The whole table, replaced in one nft transaction."""
    out = [f"table netdev {TABLE}", f"delete table netdev {TABLE}", f"table netdev {TABLE} {{"]
    for k in sorted(st["nics"]):
        n = st["nics"][k]
        tap, mac = n["tap"], n["mac"]
        peers = sorted((st["nics"][p]["tap"], st["nics"][p]["mac"]) for p in st["nics"]
                       if p != k and n["net"] is not None and n["net"] not in ROUTED
                       and st["nics"][p]["net"] == n["net"])
        out.append(f"  chain in_{tap} {{")
        out.append(f'    type filter hook ingress device "{tap}" priority filter; policy drop;')
        out.append(f"    # {k} on {n['net'] or '(no network)'}")
        if n["net"] == UPLINK:
            # To the host stack, from the guest's MAC and address only; inet vmswitch
            # decides what is routed.
            host, guest = routed_ips(n)
            out.append(f"    ether saddr {mac} arp saddr ip {guest} accept")
            out.append(f"    ether saddr {mac} ip saddr {guest} accept")
            out.append("  }")
            out.append(f"  chain out_{tap} {{")
            out.append(f'    type filter hook egress device "{tap}" priority filter; policy drop;')
            out.append(f"    arp saddr ip {host} accept")
            out.append(f"    ip saddr != {guest} ip daddr {guest} accept")
            out.append("  }")
            continue
        if n["net"] == LLM:
            # ARP with the host's end, and TCP to the model server only, both ways.
            host, guest = routed_ips(n)
            out.append(f"    ether saddr {mac} arp saddr ip {guest} accept")
            out.append(f"    ether saddr {mac} ip saddr {guest} ip daddr {LLM_ADDR} tcp dport {LLM_PORT} accept")
            out.append("  }")
            out.append(f"  chain out_{tap} {{")
            out.append(f'    type filter hook egress device "{tap}" priority filter; policy drop;')
            # The host's ARP for the guest carries the reply's source (arp_announce 0):
            # the model server's address as well as the /30 end.
            out.append(f"    arp saddr ip {{ {host}, {LLM_ADDR} }} accept")
            out.append(f"    ip saddr {LLM_ADDR} ip daddr {guest} tcp sport {LLM_PORT} accept")
            out.append("  }")
            continue
        for p, _ in peers:
            out.append(f'    ether saddr {mac} dup to "{p}"')
        out.append("  }")
        # dup'd frames pass the egress hook too: let through only a peer's frames on
        # this network. Everything else, the host's own frames included, is dropped.
        out.append(f"  chain out_{tap} {{")
        out.append(f'    type filter hook egress device "{tap}" priority filter; policy drop;')
        if peers:
            out.append(f"    ether saddr {{ {', '.join(m for _, m in peers)} }} accept")
        out.append("  }")
    out.append("}")
    up = sorted(n["tap"] for n in st["nics"].values() if n["net"] == UPLINK)
    llm = sorted(n["tap"] for n in st["nics"].values() if n["net"] == LLM)
    out += [f"table inet {TABLE}", f"delete table inet {TABLE}"]
    if not (up or llm):
        return "\n".join(out) + "\n"
    out.append(f"table inet {TABLE} {{")
    for name, taps in (("uplinks", up), ("llms", llm)):
        if taps:
            out.append(f"  set {name} {{ type ifname; elements = {{ {', '.join(f'"{t}"' for t in taps)} }}; }}")
    out += ["  # Guests never reach the host's own services; llm NICs only the model server.",
            "  chain input {",
            "    type filter hook input priority filter; policy accept;"]
    if llm:
        out.append(f"    iifname @llms ip daddr {LLM_ADDR} tcp dport {LLM_PORT} accept")
    out += ['    iifname "vs*" drop', "  }"]
    if up:
        out += ["  # The host routes only uplink flows while this table exists.",
                "  chain forward {",
                "    type filter hook forward priority filter; policy drop;",
                '    iifname "vs*" oifname "vs*" drop',
                f"    iifname @uplinks ip daddr {{ {NO_ROUTE} }} drop",
                '    iifname @uplinks oifname != "vs*" meta nfproto ipv4 accept',
                "    oifname @uplinks ct state established,related accept",
                "  }",
                "  chain postrouting {",
                "    type nat hook postrouting priority srcnat; policy accept;",
                '    iifname @uplinks oifname != "vs*" masquerade',
                "  }"]
    out.append("}")
    return "\n".join(out) + "\n"


def llm_dev(want):
    """llm0 holds the model server's address while any NIC is on llm."""
    have = os.path.exists(f"/sys/class/net/{LLM_DEV}")
    if want and not have:
        run("ip", "link", "add", LLM_DEV, "type", "dummy")
        run("ip", "link", "set", "dev", LLM_DEV, "addrgenmode", "none", "arp", "off", "up")
        run("ip", "addr", "add", LLM_ADDR + "/32", "dev", LLM_DEV)
    elif have and not want:
        run("ip", "link", "del", LLM_DEV)


def apply(st):
    for n in st["nics"].values():
        tap_create(n)
    llm_dev(any(n["net"] == LLM for n in st["nics"].values()))
    rs = ruleset(st)
    run("nft", "-c", "-f", "-", input=rs)
    run("nft", "-f", "-", input=rs)
    if any(n["net"] == UPLINK for n in st["nics"].values()):
        with open("/proc/sys/net/ipv4/ip_forward") as f:
            on = f.read().strip() == "1"
        if not on:
            with open("/proc/sys/net/ipv4/ip_forward", "w") as f:
                f.write("1")


def usb_devices():
    """usbguard's view: id, target, vid, pid, name, port, interface classes."""
    devs = []
    for line in run("usbguard", "list-devices").splitlines():
        m = USBDEV.match(line)
        if m:
            i, target, vid, pid, name, port, ifs = m.groups()
            devs.append({"id": int(i), "target": target, "vid": vid, "pid": pid,
                         "name": name, "port": port, "hub": ifs.strip("{} ").startswith("09:")})
    return devs


def usb_find(dev_id):
    for d in usb_devices():
        if str(d["id"]) == dev_id:
            return d
    die(f"no USB device {dev_id} (see vmswitch usb list)")


def hostdev_xml(d):
    base = f"{SYSFS}/bus/usb/devices/{d['port']}"
    try:
        bus, dev = (int(open(f"{base}/{f}").read()) for f in ("busnum", "devnum"))
    except (OSError, ValueError):
        die(f"USB device {d['id']} has no sysfs node at port {d['port']}")
    return (f"<hostdev mode='subsystem' type='usb' managed='yes'><source>"
            f"<vendor id='0x{d['vid']}'/><product id='0x{d['pid']}'/>"
            f"<address bus='{bus}' device='{dev}'/></source></hostdev>")


def usb(st, args):
    st.setdefault("usb", {})
    if args == ["list"]:
        for d in usb_devices():
            on = st["usb"].get(f"{d['port']}/{d['vid']}:{d['pid']}")
            print(f"{d['id']}\t{d['target']}\t{d['vid']}:{d['pid']}\t{d['port']}\t"
                  f"{'hub' if d['hub'] else (on or '-')}\t{d['name']}")
        return False
    if len(args) != 3 or args[0] not in ("attach", "detach"):
        die("usage: vmswitch usb list | attach|detach <guest> <id>")
    op, guest, dev_id = args[0], check_name("guest", args[1]), args[2]
    d = usb_find(dev_id)
    if d["hub"]:
        die("hubs stay on the host")
    k = f"{d['port']}/{d['vid']}:{d['pid']}"
    xml = hostdev_xml(d)
    tmp = f"{STATE}.hostdev.xml"
    with open(tmp, "w") as f:
        f.write(xml + "\n")
    if op == "attach":
        if st["usb"].get(k) not in (None, guest):
            die(f"device {dev_id} is on {st['usb'][k]}; detach it there first")
        run("usbguard", "allow-device", str(d["id"]))
        r = subprocess.run((*VIRSH, "attach-device", guest, tmp, "--live"), capture_output=True, text=True)
        if r.returncode:
            run("usbguard", "block-device", str(d["id"]))
            die(f"attach to {guest} failed, device blocked again: {r.stderr.strip()}")
        st["usb"][k] = guest
    else:
        if st["usb"].get(k) != guest:
            die(f"device {dev_id} is not on {guest}")
        r = subprocess.run((*VIRSH, "detach-device", guest, tmp, "--live"), capture_output=True, text=True)
        # Blocked again even if the guest is gone (then libvirt has nothing to detach).
        run("usbguard", "block-device", str(d["id"]))
        del st["usb"][k]
        if r.returncode:
            print(f"vmswitch: detach from {guest}: {r.stderr.strip()} (device blocked anyway)",
                  file=sys.stderr)
    os.unlink(tmp)
    return True


def main(argv):
    if not argv:
        die("usage: see the header of this file (show, net, nic, plug, apply, xml)")
    if os.geteuid() != 0 and argv[0] not in ("xml",):
        die("run as root")
    os.makedirs(os.path.dirname(STATE), mode=0o700, exist_ok=True)
    lock = open(STATE + ".lock", "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    st = load()
    cmd, args = argv[0], argv[1:]
    if cmd == "show" and not args:
        json.dump(st, sys.stdout, indent=1, sort_keys=True)
        print()
        return
    if cmd == "net" and len(args) == 2 and args[0] in ("add", "del"):
        net = check_name("network", args[1])
        if net in ROUTED:
            die(f"{net} is built in")
        if args[0] == "add":
            if net in st["nets"]:
                die(f"network {net} exists")
            st["nets"].append(net)
            st["nets"].sort()
        else:
            if net not in st["nets"]:
                die(f"no network {net}")
            st["nets"].remove(net)
            for n in st["nics"].values():
                if n["net"] == net:
                    n["net"] = None
    elif cmd == "nic" and len(args) == 3 and args[0] in ("add", "del"):
        k = key(args[1], args[2])
        if args[0] == "add":
            if k in st["nics"]:
                die(f"NIC {k} exists")
            tap, mac = derive(k)
            if any(n["tap"] == tap for n in st["nics"].values()):
                die(f"TAP name clash for {k}")
            st["nics"][k] = {"tap": tap, "mac": mac, "net": None}
        else:
            n = st["nics"].pop(k, None) or die(f"no NIC {k}")
            apply(st)          # drop its chains before the device goes
            tap_delete(n["tap"])
            save(st)
            return
    elif cmd == "plug" and len(args) == 3:
        k = key(args[0], args[1])
        if k not in st["nics"]:
            die(f"no NIC {k}")
        net = None if args[2] == "-" else check_name("network", args[2])
        if net is not None and net not in ROUTED and net not in st["nets"]:
            die(f"no network {net}")
        n = st["nics"][k]
        n.pop("slot", None)
        if net in ROUTED:
            used = {m.get("slot") for m in st["nics"].values() if m["net"] == net}
            n["slot"] = next((i for i in range(ROUTED[net][1]) if i not in used), None)
            if n["slot"] is None:
                die(f"no free {net} /30 left")
        n["net"] = net
    elif cmd == "apply" and not args:
        pass
    elif cmd == "usb":
        if usb(st, args):
            save(st)
        return
    elif cmd == "xml" and len(args) == 2:
        k = key(*args)
        n = st["nics"].get(k) or die(f"no NIC {k}")
        print(f"<interface type='ethernet'>\n  <mac address='{n['mac']}'/>\n"
              f"  <target dev='{n['tap']}' managed='no'/>\n  <model type='virtio'/>\n"
              f"</interface>")
        if n["net"] == UPLINK:
            host, guest = routed_ips(n)
            print(f"<!-- in the guest (no DHCP): address {guest}/30, gateway {host}, "
                  f"DNS a public resolver, e.g. 9.9.9.9 -->")
        elif n["net"] == LLM:
            host, guest = routed_ips(n)
            print(f"<!-- in the guest (no DHCP): address {guest}/30, route {LLM_ADDR}/32 via {host}; "
                  f"the API is http://{LLM_ADDR}:{LLM_PORT}/v1 (key: llm key show on the host) -->")
        return
    else:
        die(f"bad command: {' '.join(argv)}")
    apply(st)
    save(st)


if __name__ == "__main__":
    main(sys.argv[1:])
