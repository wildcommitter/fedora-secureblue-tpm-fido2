# Test-only layer on the image rootfs for vmgui-e2e.sh and vmgui-wire-e2e.sh: dbus for
# the session, wtype/wlrctl (virtual keyboard and pointer) for the wire input checks,
# xwayland-satellite and xterm for the xorg variant (what vmgui-guest-xorg runs), and
# optionally a scroll RPM from the `scrollrpm` context (an empty dir otherwise),
# to test a fork branch before the image pins it.
ARG IMAGE=localhost/scroll-secure-rootfs:latest
FROM ${IMAGE}
RUN --mount=type=bind,from=scrollrpm,target=/rpm \
    if ls /rpm/scroll-[0-9]*.rpm > /dev/null 2>&1; then \
        dnf -y install --setopt=install_weak_deps=False /rpm/scroll-[0-9]*.rpm; fi \
 && dnf -y install dbus-daemon wtype wlrctl xwayland-satellite xterm && dnf clean all
